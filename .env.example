# ==============================================================================
# ARGVTIX — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your deployment-specific values.
# NEVER commit .env containing actual secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# Options: development, staging, production
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL for Staging/Production, SQLite for Local Dev)
# Staging/Prod: postgresql://username:password@postgres-host:5432/database_name
# Local Dev fallback: sqlite:///./argvtix.db
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://argvtix_user:change_me_to_secure_db_pass@localhost:5432/argvtix_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
SQL_ECHO=false

# ------------------------------------------------------------------------------
# 3. Redis Distributed Caching & Idempotency Store
# Required for multi-replica Kubernetes / Docker deployments
# Example: redis://:redis_password@redis-host:6379/0
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Authentication, JWT & RBAC
# ARGVTIX_AUTH_ENABLED: Set to true in staging/production (auto-enforced in prod)
# ARGVTIX_JWT_SECRET: High-entropy secret key (min 32 bytes) for HS256 tokens
# ARGVTIX_ALLOW_INSECURE_DEV_AUTH: Explicit opt-in flag required for insecure dev password bypass
# ------------------------------------------------------------------------------
ARGVTIX_AUTH_ENABLED=true
ARGVTIX_JWT_SECRET=generate_high_entropy_secret_min_32_bytes_change_in_prod
ARGVTIX_ALLOW_INSECURE_DEV_AUTH=false

# Enterprise Credentials (used for initial operator/admin provisioning)
ARGVTIX_ADMIN_USER=admin
ARGVTIX_ADMIN_PASSWORD=change_me_admin_secure_password
ARGVTIX_OPERATOR_PASSWORD=change_me_operator_secure_password
ARGVTIX_VIEWER_PASSWORD=change_me_viewer_secure_password

# ------------------------------------------------------------------------------
# 5. Anti-Abuse & Cloudflare Turnstile
# Required in production for public form protection (contact/demo endpoints)
# ------------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA_your_cloudflare_turnstile_secret_here

# ------------------------------------------------------------------------------
# 6. LLM Providers & Model Gateway
# At least one key required for live agent workflows; mock fallback available
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 7. LLM Spend Guard (Cost Governance)
# ------------------------------------------------------------------------------
ARGVTIX_DAILY_LLM_CAP_USD=50.0
ARGVTIX_MONTHLY_LLM_CAP_USD=500.0

# ------------------------------------------------------------------------------
# 8. Network Ingress, Domains & CORS
# ------------------------------------------------------------------------------
CUSTOM_DOMAIN=app.argvtix.ai
VITE_APP_DOMAIN=https://app.argvtix.ai
ARGVTIX_ALLOWED_ORIGINS=https://app.argvtix.ai,http://localhost:5173,http://127.0.0.1:5173
